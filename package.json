{
  "name": "repograph",
  "version": "0.1.0",
  "private": true,
  "description": "RepoGraph by aayanlabs — A local-first semantic code graph for AI coding agents.",
  "author": "aayanlabs <mdaayanmalik9291@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "repograph": "packages/cli/dist/index.js"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "clean": "pnpm --recursive --if-present clean",
    "dev": "pnpm --filter @repograph/cli dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages vitest.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
